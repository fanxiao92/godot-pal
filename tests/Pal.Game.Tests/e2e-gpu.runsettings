<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <MaxCpuCount>1</MaxCpuCount>
    <TestSessionTimeout>300000</TestSessionTimeout>
    <TreatNoTestsAsError>true</TreatNoTestsAsError>
  </RunConfiguration>
  <GdUnit4>
    <Parameters>--audio-driver Dummy</Parameters>
    <DisplayName>FullyQualifiedName</DisplayName>
    <CaptureStdOut>false</CaptureStdOut>
    <CompileProcessTimeout>30000</CompileProcessTimeout>
    <GodotConnectTimeout>15000</GodotConnectTimeout>
    <TolerateExitCodeAfterCompletion>false</TolerateExitCodeAfterCompletion>
  </GdUnit4>
</RunSettings>
