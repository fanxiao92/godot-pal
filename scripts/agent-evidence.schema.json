{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    { "$ref": "#/$defs/state" },
    { "$ref": "#/$defs/feedback" }
  ],
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "nullableText": { "type": ["string", "null"], "minLength": 1 },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["worktree", "branch", "head", "tree", "dirty", "binding"],
      "properties": {
        "worktree": { "$ref": "#/$defs/text" }, "branch": { "$ref": "#/$defs/text" },
        "head": { "$ref": "#/$defs/sha" }, "tree": { "$ref": "#/$defs/sha" },
        "dirty": { "type": "boolean" }, "binding": { "$ref": "#/$defs/text" }
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["sdkRemaining", "writer", "runId", "deadlineUtc"],
      "properties": {
        "sdkRemaining": { "type": "integer", "minimum": 0 },
        "writer": { "$ref": "#/$defs/nullableText" }, "runId": { "$ref": "#/$defs/nullableText" },
        "deadlineUtc": { "$ref": "#/$defs/nullableText" }
      }
    },
    "ticket": {
      "type": "object", "additionalProperties": false,
      "required": ["number", "state", "source", "authority", "lastAttempt", "checks", "openContracts", "limits", "inputs"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["ready", "running", "blocked", "candidate", "accepted"] },
        "source": { "$ref": "#/$defs/source" }, "authority": { "$ref": "#/$defs/authority" },
        "lastAttempt": { "type": ["object", "null"] },
        "checks": { "type": "array", "items": { "type": "object" } },
        "openContracts": { "type": "array", "items": { "type": "object" } },
        "limits": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "inputs": { "type": "object", "additionalProperties": { "$ref": "#/$defs/text" } }
      },
      "if": { "properties": { "state": { "const": "running" } } },
      "then": { "properties": { "authority": { "properties": { "runId": { "$ref": "#/$defs/text" }, "deadlineUtc": { "$ref": "#/$defs/text" } } } } },
      "else": { "properties": { "authority": { "properties": { "sdkRemaining": { "const": 0 }, "writer": { "type": "null" }, "runId": { "type": "null" }, "deadlineUtc": { "type": "null" } } } } }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "scope", "integration", "active_ticket", "receipts", "history", "nextAction", "updatedUtc"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "derived_execution_index_not_issue_tracker" },
        "scope": { "type": "object" }, "integration": { "type": "object" },
        "active_ticket": { "$ref": "#/$defs/ticket" },
        "receipts": { "type": "object" },
        "history": {
          "type": "object", "additionalProperties": false, "required": ["snapshot", "sha256"],
          "properties": { "snapshot": { "$ref": "#/$defs/text" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
        },
        "nextAction": {
          "type": "object", "additionalProperties": false, "required": ["action", "reason", "plan"],
          "properties": { "action": { "enum": ["wait", "plan", "dispatch", "review", "integrate"] }, "reason": { "$ref": "#/$defs/text" }, "plan": { "$ref": "#/$defs/nullableText" } }
        },
        "updatedUtc": { "$ref": "#/$defs/text" }
      }
    },
    "native": {
      "type": "object", "additionalProperties": false,
      "required": ["exitCode", "rootExited", "stdoutComplete", "stderrComplete", "cleanupComplete", "timedOut", "startedUtc", "endedUtc"],
      "properties": {
        "exitCode": { "type": ["integer", "null"] },
        "rootExited": { "type": "boolean" }, "stdoutComplete": { "type": "boolean" },
        "stderrComplete": { "type": "boolean" }, "cleanupComplete": { "type": "boolean" }, "timedOut": { "type": "boolean" },
        "startedUtc": { "$ref": "#/$defs/text" }, "endedUtc": { "$ref": "#/$defs/text" }
      }
    },
    "feedback": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "phase", "assembly", "total", "native", "files", "expectedFailures", "allowedWarnings"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "agent_test_feedback" },
        "phase": { "enum": ["red", "green"] }, "assembly": { "$ref": "#/$defs/text" },
        "total": { "type": "integer", "minimum": 1 }, "native": { "$ref": "#/$defs/native" },
        "files": {
          "type": "object", "additionalProperties": false, "required": ["trx", "stdout", "stderr"],
          "properties": { "trx": { "$ref": "#/$defs/text" }, "stdout": { "$ref": "#/$defs/text" }, "stderr": { "$ref": "#/$defs/text" } }
        },
        "expectedFailures": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "messageContains", "stackContains"],
            "properties": { "name": { "$ref": "#/$defs/text" }, "messageContains": { "$ref": "#/$defs/text" }, "stackContains": { "$ref": "#/$defs/text" } }
          }
        },
        "allowedWarnings": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
      },
      "if": { "properties": { "phase": { "const": "red" } } },
      "then": { "properties": { "expectedFailures": { "minItems": 1 } } },
      "else": { "properties": { "expectedFailures": { "maxItems": 0 } } }
    }
  }
}
